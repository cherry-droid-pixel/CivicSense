// ======================================================
// CIVICSENSE LEAFLET MAP
// ======================================================

let civicMap = null;
let civicMapMarkers = [];

function initializeCivicMap() {

    const mapElement = document.getElementById("civicMap");

    if (!mapElement) {
        console.warn("Civic map element not found.");
        return;
    }

    // Prevent duplicate initialization
    if (civicMap) {
        civicMap.invalidateSize();
        return;
    }

    if (typeof L === "undefined") {
        console.error("Leaflet is not loaded.");
        return;
    }

    // Default: Hyderabad
    civicMap = L.map("civicMap", {
        center: [17.3850, 78.4867],
        zoom: 12,
        zoomControl: true
    });

    // OpenStreetMap tiles
    L.tileLayer(
        "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
        {
            maxZoom: 19,
            attribution:
                '&copy; OpenStreetMap contributors'
        }
    ).addTo(civicMap);

    console.log("CivicSense map initialized.");

    loadCivicMapComplaints();

    setTimeout(() => {
        civicMap.invalidateSize();
    }, 300);
}


// ======================================================
// LOAD COMPLAINTS ON MAP
// ======================================================

async function loadCivicMapComplaints() {

    if (!civicMap) {
        return;
    }

    try {

        const response = await fetch(
            `${API_BASE_URL}/api/complaints`,
            {
                method: "GET",
                credentials: "include"
            }
        );

        if (!response.ok) {
            console.warn(
                "Unable to load map complaints:",
                response.status
            );
            return;
        }

        const complaints = await response.json();

        console.log(
            "Map complaints:",
            complaints
        );

        clearCivicMapMarkers();

        if (!Array.isArray(complaints)) {
            return;
        }

        complaints.forEach(complaint => {

            if (
                complaint.latitude === null ||
                complaint.longitude === null ||
                complaint.latitude === undefined ||
                complaint.longitude === undefined
            ) {
                return;
            }

            const lat = Number(complaint.latitude);
            const lng = Number(complaint.longitude);

            if (
                !Number.isFinite(lat) ||
                !Number.isFinite(lng)
            ) {
                return;
            }

            const status =
                String(
                    complaint.status || "PENDING"
                ).toUpperCase();

            let markerColor = "#f59e0b";

            if (status === "RESOLVED") {
                markerColor = "#16a34a";
            }

            if (status === "IN_PROGRESS") {
                markerColor = "#7c3aed";
            }

            const marker = L.circleMarker(
                [lat, lng],
                {
                    radius: 9,
                    fillColor: markerColor,
                    color: "#ffffff",
                    weight: 3,
                    opacity: 1,
                    fillOpacity: 0.9
                }
            );

            const title =
                escapeHtml(
                    complaint.title ||
                    "Civic Issue"
                );

            const category =
                escapeHtml(
                    complaint.category ||
                    "General"
                );

            const location =
                escapeHtml(
                    complaint.location ||
                    "Location not provided"
                );

            const priority =
                escapeHtml(
                    complaint.priority ||
                    "MEDIUM"
                );

            marker.bindPopup(`
                <div style="
                    min-width:220px;
                    font-family:Inter,Arial,sans-serif;
                ">
                    <strong style="
                        display:block;
                        font-size:15px;
                        margin-bottom:8px;
                    ">
                        ${title}
                    </strong>

                    <div style="
                        font-size:12px;
                        color:#64748b;
                        margin-bottom:5px;
                    ">
                        Category: ${category}
                    </div>

                    <div style="
                        font-size:12px;
                        color:#64748b;
                        margin-bottom:5px;
                    ">
                        Location: ${location}
                    </div>

                    <div style="
                        font-size:12px;
                        color:#64748b;
                        margin-bottom:5px;
                    ">
                        Priority: ${priority}
                    </div>

                    <div style="
                        font-size:12px;
                        font-weight:700;
                    ">
                        Status: ${formatStatus(status)}
                    </div>
                </div>
            `);

            marker.addTo(civicMap);

            civicMapMarkers.push(marker);
        });

    } catch (error) {

        console.error(
            "Civic map loading error:",
            error
        );
    }
}


// ======================================================
// CLEAR MAP MARKERS
// ======================================================

function clearCivicMapMarkers() {

    civicMapMarkers.forEach(marker => {

        if (civicMap) {
            civicMap.removeLayer(marker);
        }

    });

    civicMapMarkers = [];
}


// ======================================================
// MAP REFRESH BUTTON
// ======================================================

function initializeMapRefreshButton() {

    const button =
        document.getElementById(
            "refreshMapButton"
        );

    if (!button) {
        return;
    }

    button.addEventListener(
        "click",
        async () => {

            button.disabled = true;

            const originalText =
                button.textContent;

            button.textContent =
                "↻ Refreshing...";

            try {

                await loadCivicMapComplaints();

                if (civicMap) {
                    civicMap.invalidateSize();
                }

            } finally {

                button.disabled = false;

                button.textContent =
                    originalText;
            }
        }
    );
}


// ======================================================
// MAP INITIALIZATION
// ======================================================

document.addEventListener(
    "DOMContentLoaded",
    () => {

        initializeCivicMap();

        initializeMapRefreshButton();

    }
);
